{
	"$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": { "includes": ["**", "!**/*.md"] },
	"formatter": { "indentStyle": "tab", "lineWidth": 120 },
	"javascript": { "formatter": { "quoteStyle": "double", "semicolons": "always" } },
	"linter": {
		"rules": {
			"preset": "recommended",
			"correctness": { "noUnusedFunctionParameters": "off", "useYield": "off" },
			"style": { "noNonNullAssertion": "off" },
			"suspicious": { "noAssignInExpressions": "off", "noControlCharactersInRegex": "off", "noExplicitAny": "off" }
		}
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } }
}
